# Force LF line endings for files that run or get parsed on Linux (droplet, containers),
# regardless of core.autocrlf on the checkout machine. A CRLF shebang line silently breaks
# script execution ("bash\r: not found") without any error at commit/push time.
*.sh            text eol=lf
*.sh.tpl        text eol=lf
Dockerfile*     text eol=lf
docker-compose*.yml text eol=lf
*.conf          text eol=lf
.env*           text eol=lf
