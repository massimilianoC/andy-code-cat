/data/

# ─── Logs ────────────────────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ─── Private infrastructure (server IPs, SSH keys, live deploy runbooks) ─────
docker-compose.droplet.yml
docker-compose.override.yml
scripts/deploy-to-droplet.sh
scripts/seed-droplet.sh
nginx/sites-enabled/
.deploy/

# ─── Private operational docs (not for public repo) ──────────────────────────
docs/_archive/
docs/deploy/
docs/review/
docs/cost-providers/bills_*
