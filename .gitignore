# ─── Dependencies ────────────────────────────────────────────────────────────
node_modules/
.next/
dist/
coverage/

# ─── Environment files (NEVER commit live secrets) ───────────────────────────
# Every .env file is local. Only the two committed templates are tracked.
.env
.env.*
!.env.example
!.env.deploy.example

# ─── Local data volumes ───────────────────────────────────────────────────────
/data/

# ─── Logs ────────────────────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ─── Private infrastructure (server IPs, SSH keys, live deploy runbooks) ─────
# Host-specific deploy material lives in .deploy/ (scripts, compose overrides,
# runbooks). The other names are legacy locations kept ignored on purpose.
docker-compose.override.yml
docker-compose.*.local.yml
docker-compose.droplet.yml
scripts/deploy-to-*.sh
scripts/seed-*.sh
nginx/sites-enabled/
.deploy/

# ─── Private operational docs (not for public repo) ──────────────────────────
docs/_archive/
docs/deploy/
docs/review/
docs/cost-providers/bills_*
docs/cost-providers/sf-probe-*.json
docs/cost-providers/siliconflow_pricing.csv

# ─── Test outputs (generated, never commit) ──────────────────────────────────
test-results/
tests/test-results/
tests/e2e/report/

# ─── Test outputs from MCP-driven browser sessions ───────────────────────────
# Accessibility dumps written by the Playwright MCP server. 56 of these were once
# committed; they are session scratch, never a deliverable.
.playwright-mcp/

# ─── Debug / scratch ─────────────────────────────────────────────────────────
# The whole folder, not just debug/sample/. Probe and diagnostic output, ad-hoc
# screenshots, and one-off exports land here — generated, often large, and never
# reviewable. None of it belongs in a public repo.
debug/
health_test.json

# ─── Build artifacts ─────────────────────────────────────────────────────────
*.tsbuildinfo

# ─── Editor and one-off backups ──────────────────────────────────────────────
*.bak
*.orig
*.rej
*~

# ─── Screenshots at the repository root ──────────────────────────────────────
# Documentation images belong under docs/. A PNG in the root is a leftover from
# a manual verification run — six of them once shipped to the public repo.
/*.png
/*.jpg
/*.jpeg
/*.gif
/*.webp

# ─── Local working notes (operator scratch, never published) ────────────────
# Italian analysis notes, drafts, and other local-only scratch documents live
# here. Gitignored on purpose: see "Local working notes" in
# docs/guides/PUBLIC_REPO_CHECKLIST.md.
/notes/

# ─── OS / IDE ─────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.vscode/settings.json
docs/brand/Gatto_Codifica_Video_Generato.mp4

# ─── Private key material ─────────────────────────────────────────────────────
# Belt to the guard's braces (scripts/public-repo-guard.mjs). This is a public
# repository: a leaked deploy key is a root shell on the server.
id_rsa
id_dsa
id_ecdsa
id_ed25519
vps_admin
*.pem
*.p12
*.pfx
.ssh/

# ─── Claude Code agent worktrees and local settings ────────────────────────
.claude/worktrees/
.claude/settings.local.json
